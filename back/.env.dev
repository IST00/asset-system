# ============================================================================
# Dev / Test profile defaults.
# Loaded automatically when FLASK_ENV=dev (default) or FLASK_ENV=test.
#
# Rules:
#   - System environment variables ALWAYS win over values in this file.
#     (config.bootstrap_env loads with override=False)
#   - Leaving an optional feature key UNSET disables that feature.
#   - This file IS committed; never put real secrets here.
# ============================================================================

# --- Profile -----------------------------------------------------------------
FLASK_ENV=dev

# --- Security ----------------------------------------------------------------
SECRET_KEY=dev-flask-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me-change-me-change-me
JWT_EXPIRE_SECONDS=86400

# --- Database ----------------------------------------------------------------
# 二选一：
# 1. 设置完整连接串（密码中的特殊字符需要先进行 URL 编码）：
# DB_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@YOUR_MYSQL_HOST:3306/YOUR_DATABASE?charset=utf8mb4
# 2. 保持 DB_URL 未设置，填写下面五项：
DB_HOST=rm-bp16xk8stl0473obz.mysql.rds.aliyuncs.com
DB_PORT=3306
DB_USER=fddsh_t_57_FL0Raw
DB_PASSWORD=2QPl7Hqt6mZARFLi9N
DB_NAME=asset-system_test
DB_URL=mysql+pymysql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?charset=utf8mb4

# --- Celery (UNSET = disabled) -----------------------------------------------
# CELERY_BROKER_URL=<broker-url>
# CELERY_RESULT_BACKEND=<result-backend-url>

# --- CORS / Logging ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=DEBUG
LOG_PATH=logs
LOG_FILE_ENABLED=true
LOG_CONSOLE=true

# --- Health check ------------------------------------------------------------
HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0
