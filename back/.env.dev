# ============================================================================
# Local development / test simulation defaults. This file is committed.
# Never add remote hosts, database credentials, or deployment secrets here.
# ============================================================================

FLASK_ENV=dev

# Development-only simulation values; never reuse them outside local/test.
SECRET_KEY=development-only-simulation-secret-key
JWT_SECRET=development-only-simulation-jwt-secret
JWT_EXPIRE_SECONDS=28800
SESSION_IDLE_MINUTES=120
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
USER_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=true

# Local development uses config.py's sqlite:///instance/dev.db default.
# To test MySQL, copy .env.pilot.example to the ignored .env.pilot file and run:
# FLASK_ENV=prod ENV_FILE=/absolute/path/to/.env.pilot python manage.py run
MYSQL_REQUIRED_SERIES=8.4

CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
LOG_PATH=logs
LOG_FILE_ENABLED=false
LOG_CONSOLE=true

HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0
