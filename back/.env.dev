# ============================================================================
# Dev / Test profile defaults.
# Loaded automatically when FLASK_ENV=dev (default) or FLASK_ENV=test.
#
# Rules:
#   - System environment variables ALWAYS win over values in this file.
#     (config.bootstrap_env loads with override=False)
#   - Leaving a key UNSET (commented out or removed) disables the related
#     feature, e.g. an unset/empty REDIS_HOST means "no redis here".
#   - This file IS committed; never put real secrets here.
# ============================================================================

# --- Profile -----------------------------------------------------------------
FLASK_ENV=dev

# --- Security ----------------------------------------------------------------
SECRET_KEY=dev-flask-secret-change-me
JWT_SECRET=dev-jwt-secret-change-me-change-me-change-me
JWT_EXPIRE_SECONDS=86400

# --- Database (sqlite by default, no external deps) --------------------------
DB_URL=sqlite:///instance/dev.db

# --- Redis (UNSET = disabled; health check will skip redis) ------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379

# --- Celery (UNSET = disabled) -----------------------------------------------
# CELERY_BROKER_URL=redis://localhost:6379/0
# CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- CORS / Logging ----------------------------------------------------------
CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=DEBUG
LOG_PATH=logs
LOG_FILE_ENABLED=true
LOG_CONSOLE=true

# --- Health check ------------------------------------------------------------
HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0

# --- DeepSeek (Keke H5 story generator) --------------------------------------
# Leave empty locally — StoryService returns a friendly business error so
# the rest of the H5 (intro/home/gallery/history) keeps working without it.
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_TIMEOUT_SECONDS=120
