# Copy to the ignored .env.pilot file and inject real values at deployment.
FLASK_ENV=prod
DEPLOYMENT_STAGE=pilot

SECRET_KEY=CHANGE_ME_PILOT_SECRET_KEY
JWT_SECRET=CHANGE_ME_PILOT_JWT_SECRET
JWT_EXPIRE_SECONDS=28800
SESSION_IDLE_MINUTES=120
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
USER_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=true

DB_HOST=CHANGE_ME_PILOT_DB_HOST
DB_PORT=3306
DB_USER=CHANGE_ME_PILOT_DB_USER
DB_PASSWORD=CHANGE_ME_PILOT_DB_PASSWORD
DB_NAME=CHANGE_ME_PILOT_DB_NAME
MYSQL_REQUIRED_SERIES=8.4

CORS_ALLOWED_ORIGINS=https://CHANGE_ME_PILOT_HOST

LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_CONSOLE=true
GUNICORN_BIND=0.0.0.0:8080
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0
