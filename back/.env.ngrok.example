# Copy to the ignored .env.ngrok.local and fill in real credentials.
# Start with:
# ENV_FILE="$PWD/.env.ngrok.local" python manage.py run
FLASK_ENV=dev
FEISHU_INTEGRATION_ENABLED=true
FEISHU_APP_ID=CHANGE_ME_FEISHU_APP_ID
FEISHU_APP_SECRET=CHANGE_ME_FEISHU_APP_SECRET
FEISHU_VERIFICATION_TOKEN=CHANGE_ME_FEISHU_VERIFICATION_TOKEN
FEISHU_ENCRYPT_KEY=CHANGE_ME_FEISHU_ENCRYPT_KEY
FEISHU_REDIRECT_URI=https://CHANGE_ME_NGROK_HOST/feishu/callback
FEISHU_APPROVAL_CODE=CHANGE_ME_FEISHU_APPROVAL_CODE
FEISHU_DIRECTORY_SYNC_ENABLED=true
FEISHU_NOTIFICATION_ENABLED=true
