# Copy to the ignored .env.deploy file or inject values from a secret manager.
FLASK_ENV=prod
DEPLOYMENT_STAGE=production

SECRET_KEY=CHANGE_ME_PRODUCTION_SECRET_KEY
JWT_SECRET=CHANGE_ME_PRODUCTION_JWT_SECRET
JWT_EXPIRE_SECONDS=259200
SESSION_IDLE_MINUTES=720
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
USER_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=true

DB_HOST=CHANGE_ME_PRODUCTION_DB_HOST
DB_PORT=3306
DB_USER=CHANGE_ME_PRODUCTION_DB_USER
DB_PASSWORD=CHANGE_ME_PRODUCTION_DB_PASSWORD
DB_NAME=CHANGE_ME_PRODUCTION_DB_NAME
MYSQL_REQUIRED_SERIES=8.4

CORS_ALLOWED_ORIGINS=https://CHANGE_ME_PRODUCTION_HOST

LOG_LEVEL=INFO
LOG_FILE_ENABLED=true
LOG_CONSOLE=true
GUNICORN_BIND=0.0.0.0:8080
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0

# Feishu native integration. Use secret-manager injection in production.
FEISHU_INTEGRATION_ENABLED=true
FEISHU_APP_ID=CHANGE_ME_FEISHU_APP_ID
FEISHU_APP_SECRET=CHANGE_ME_FEISHU_APP_SECRET
FEISHU_VERIFICATION_TOKEN=CHANGE_ME_FEISHU_VERIFICATION_TOKEN
FEISHU_ENCRYPT_KEY=CHANGE_ME_FEISHU_ENCRYPT_KEY
FEISHU_REDIRECT_URI=https://CHANGE_ME_FRONTEND_HOST/feishu/callback
FEISHU_APPROVAL_CODE=CHANGE_ME_FEISHU_APPROVAL_CODE
FEISHU_DIRECTORY_SYNC_ENABLED=true
FEISHU_NOTIFICATION_ENABLED=true
