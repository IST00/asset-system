# ============================================================================
# Production profile defaults.
# Loaded automatically when FLASK_ENV=prod (e.g. python manage.py run prod
# or gunicorn started with FLASK_ENV=prod).
#
# Rules:
#   - System environment variables ALWAYS win over values in this file.
#     Real secrets MUST be injected via deployment env (docker-compose
#     environment:, systemd EnvironmentFile, K8s Secret, ...).
#   - This file IS committed; the values below are placeholders / shape
#     templates only. Do NOT put real prod secrets here.
#   - Leaving a key UNSET disables the related feature.
# ============================================================================

# --- Profile -----------------------------------------------------------------
FLASK_ENV=prod

# --- Security (override these at deploy time!) -------------------------------
SECRET_KEY=CHANGE_ME_IN_DEPLOYMENT
JWT_SECRET=CHANGE_ME_IN_DEPLOYMENT_CHANGE_ME_IN_DEPLOYMENT
JWT_EXPIRE_SECONDS=86400

# --- Database ----------------------------------------------------------------
# Either set DB_URL directly...
#DB_URL=mysql+pymysql://scaffold:CHANGE_ME@mysql:3306/scaffold?charset=utf8mb4
# ...or leave DB_URL unset and provide the four parts below:
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=scaffold
# DB_PASSWORD=CHANGE_ME
# DB_NAME=scaffold

# --- Celery (UNSET = disabled) -----------------------------------------------
# CELERY_BROKER_URL=<broker-url>
# CELERY_RESULT_BACKEND=<result-backend-url>

# --- CORS / Logging ----------------------------------------------------------
# 逗号分隔白名单。'*' 表示回显请求 Origin（仅 dev 用，生产别开）。
CORS_ALLOWED_ORIGINS=https://staff.dushu365.com,https://staff-test.dushu365.com
#LOG_LEVEL=INFO
#LOG_PATH=/var/log/back
#LOG_FILE_ENABLED=false
#2LOG_CONSOLE=true

# --- Gunicorn ----------------------------------------------------------------
GUNICORN_BIND=0.0.0.0:8080
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

# --- Health check ------------------------------------------------------------
HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0
