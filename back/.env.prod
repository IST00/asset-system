# Tracked production profile template. Never commit real credentials.
# Runtime environment variables or BACK_ENV_FILE values override this file.

FLASK_ENV=prod

SECRET_KEY=CHANGE_ME_IN_DEPLOYMENT
JWT_SECRET=CHANGE_ME_IN_DEPLOYMENT
JWT_EXPIRE_SECONDS=28800
SESSION_IDLE_MINUTES=120
LOGIN_LOCK_THRESHOLD=5
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_MINUTE=10
USER_RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_ENABLED=true

# Prefer DB_URL when deployment tooling provides a complete encoded URL.
# DB_URL=CHANGE_ME_IN_DEPLOYMENT
DB_HOST=CHANGE_ME_IN_DEPLOYMENT
DB_PORT=3306
DB_USER=CHANGE_ME_IN_DEPLOYMENT
DB_PASSWORD=CHANGE_ME_IN_DEPLOYMENT
DB_NAME=CHANGE_ME_IN_DEPLOYMENT

CORS_ALLOWED_ORIGINS=CHANGE_ME_IN_DEPLOYMENT

GUNICORN_BIND=0.0.0.0:8080
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_LOG_LEVEL=info

HEALTH_PORT=8081
HEALTH_BIND=0.0.0.0
