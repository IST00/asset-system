# 生产环境
# 跨域直连：axios baseURL 直接写后端绝对域名，后端需要配 CORS 放行 staff.dushu365.com
VITE_API_BASE_URL=https://staff-api.dushu365.com/scaffold/api/v1
# 跨域直连场景下不再用 nginx 同源前缀，留空
VITE_API_PREFIX=
# 前端静态资源部署前缀。项目名与仓库名一致，后续脚本统一替换 'scaffold'。
# 必须以 '/' 开头和结尾。Vite 的 base、BrowserRouter 的 basename、index.html 资源 URL 都跟这个走。
VITE_APP_BASE=/scaffold/
VITE_APP_TITLE=资产管理系统
VITE_APP_DESCRIPTION=企业资产全生命周期管理平台

# 是否开启神策埋点
VITE_DISABLE_SENSORS=false

# 是否是 iPad
VITE_IS_IPAD=false
VITE_ENABLE_DEMO_LOGIN=false
