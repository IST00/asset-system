VITE_API_BASE_URL=/api
# 线上业务网关前缀，nginx location 匹配后去掉再转给后端
# 因此后端不需要配 server.servlet.context-path
# 示例：VITE_API_PREFIX=/scaffold-api
VITE_API_PREFIX=/scaffold-api
# 前端静态资源部署前缀。必须以 '/' 开头和结尾。
# 打包产物里所有 index.html 引用、import 资源都会自动带上这个前缀；
# BrowserRouter 的 basename 也跟这个走，业务代码里的路由照常写 '/home'。
VITE_APP_BASE=/scaffold-ui/
VITE_APP_TITLE=Scaffold
