VITE_API_TARGET=http://localhost:8080
VITE_API_BASE_URL=/api/v1
# 本地开发不走 nginx 前缀，默认留空
# 如果本地想模拟线上完整链路（含前缀），把这里改成 /scaffold-api 之类
VITE_API_PREFIX=
# 前端静态资源部署前缀（子路径部署时用）。开发默认根路径 '/'。
# Vite 的 base、BrowserRouter 的 basename、index.html 里的资源 URL 都跟这个走。
VITE_APP_BASE=/
VITE_APP_TITLE=资产管理系统 · 开发环境
VITE_APP_DESCRIPTION=企业资产全生命周期管理平台

# 是否开启神策埋点
VITE_DISABLE_SENSORS=false

# 是否是 iPad
VITE_IS_IPAD=false

# 本地页面演示入口，仅 development 模式生效
VITE_ENABLE_DEMO_LOGIN=false
